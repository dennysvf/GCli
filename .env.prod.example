# Copy to .env.prod (ignored by git and by the Docker build) to run operational scripts against
# production from your machine: npm run setup:storage-cors:prod, npm run setup:admin:prod.
# The deployed app and worker do NOT read this file: they get their variables from the hosting
# provider's secrets. Do not name it .env.production: Next.js would load it in every `next build`.
NODE_ENV=production

DATABASE_URL=postgresql://gcli_app:CHANGE_ME@db.example.com:5432/gcli?sslmode=require
DATABASE_MIGRATION_URL=postgresql://gcli_owner:CHANGE_ME@db.example.com:5432/gcli?sslmode=require

APP_URL=https://app.example.com
BETTER_AUTH_SECRET=the-production-secret-with-32-plus-characters
TRUST_PROXY=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GCli <no-reply@example.com>

# Cloudflare R2
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=gcli-production
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

SENTRY_DSN=
LOG_LEVEL=info
