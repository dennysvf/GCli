// GCli database schema. Spec: docs/F01-platform-foundation-authentication-and-access-control/spec.md (section 6).
// Conventions (architecture section 6): UUIDv7 ids generated by the application, snake_case columns,
// varchar + CHECK constraints instead of native enums, timestamptz everywhere.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                     String   @id @db.Uuid
  legalName              String   @map("legal_name") @db.VarChar(150)
  tradeName              String?  @map("trade_name") @db.VarChar(150)
  cnpj                   String?  @db.Char(14)
  logoObjectKey          String?  @map("logo_object_key") @db.VarChar(255)
  logoVersion            Int      @default(0) @map("logo_version")
  timeZone               String   @default("America/Sao_Paulo") @map("time_zone") @db.VarChar(64)
  slotGranularityMinutes Int      @default(15) @map("slot_granularity_minutes") @db.SmallInt
  version                Int      @default(1)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById            String?  @map("updated_by_id") @db.Uuid

  users             User[]
  invitations       Invitation[]
  units             Unit[]
  serviceCategories ServiceCategory[]
  services          Service[]
  professionals     Professional[]
  patients          Patient[]

  @@map("organization")
}

// Better Auth `user` model plus GCli identity fields.
model User {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  name             String    @db.VarChar(150)
  email            String    @unique(map: "uq_app_user_email") @db.VarChar(254)
  emailVerified    Boolean   @default(false) @map("email_verified")
  image            String?   @db.VarChar(255)
  role             String    @db.VarChar(20)
  status           String    @default("ACTIVE") @db.VarChar(20)
  failedLoginCount Int       @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime? @map("last_login_at") @db.Timestamptz(6)
  deactivatedAt    DateTime? @map("deactivated_at") @db.Timestamptz(6)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization   @relation(fields: [organizationId], references: [id], map: "fk_app_user_org")
  sessions      Session[]
  accounts      Account[]
  unitSelection UnitSelection?
  professional  Professional?

  @@index([organizationId, status, role], map: "ix_app_user_org_status_role")
  @@map("app_user")
}

// Better Auth `session` model. `expiresAt` is the absolute limit (12 h, no sliding refresh);
// `lastActiveAt` drives the 60-minute idle timeout checked by the request context.
model Session {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique(map: "uq_session_token") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  lastActiveAt DateTime @default(now()) @map("last_active_at") @db.Timestamptz(6)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_session_user")

  @@index([userId], map: "ix_session_user")
  @@index([expiresAt], map: "ix_session_expires")
  @@map("session")
}

// Better Auth `account` model. The credential account stores the Argon2id password hash.
model Account {
  id                    String    @id @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(50)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_account_user")

  @@unique([providerId, accountId], map: "uq_account_provider")
  @@index([userId], map: "ix_account_user")
  @@map("account")
}

// Better Auth `verification` model (password reset tokens).
model Verification {
  id         String   @id @db.Uuid
  identifier String   @db.VarChar(255)
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier], map: "ix_verification_identifier")
  @@map("verification")
}

model Invitation {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(254)
  name           String    @db.VarChar(150)
  role           String    @db.VarChar(20)
  tokenHash      String    @unique(map: "uq_invitation_token_hash") @map("token_hash") @db.Char(64)
  status         String    @default("PENDING") @db.VarChar(20)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  invitedById    String?   @map("invited_by_id") @db.Uuid
  acceptedUserId String?   @map("accepted_user_id") @db.Uuid
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  resendCount    Int       @default(0) @map("resend_count") @db.SmallInt
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], map: "fk_invitation_org")

  @@index([organizationId, status], map: "ix_invitation_org_status")
  @@map("invitation")
}

model RateLimitBucket {
  key             String    @id @db.VarChar(200)
  count           Int       @default(0)
  windowStartedAt DateTime  @default(now()) @map("window_started_at") @db.Timestamptz(6)
  blockedUntil    DateTime? @map("blocked_until") @db.Timestamptz(6)

  @@map("rate_limit_bucket")
}

model OutboxMessage {
  id             String    @id @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  type           String    @db.VarChar(80)
  payload        Json
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt   DateTime? @map("dispatched_at") @db.Timestamptz(6)
  attempts       Int       @default(0) @db.SmallInt
  lastError      String?   @map("last_error") @db.VarChar(500)

  @@map("outbox_message")
}

// Append-only and partitioned by month on occurred_at (hand-written migration 0002).
// The runtime role has only INSERT and SELECT on this table.
model AuditEvent {
  id             String   @db.Uuid
  occurredAt     DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  organizationId String?  @map("organization_id") @db.Uuid
  actorType      String   @map("actor_type") @db.VarChar(12)
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String   @db.VarChar(40)
  entityType     String?  @map("entity_type") @db.VarChar(40)
  entityId       String?  @map("entity_id") @db.Uuid
  summary        String?  @db.VarChar(255)
  changes        Json?
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.Inet
  requestId      String?  @map("request_id") @db.VarChar(64)

  @@id([id, occurredAt])
  @@index([organizationId, occurredAt(sort: Desc)], map: "ix_audit_org_time")
  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "ix_audit_entity")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "ix_audit_actor")
  @@map("audit_event")
}

// F02 — Units and Rooms (spec docs/F02-units-and-rooms/spec.md, section 6).
// Case-insensitive unique names and CHECK constraints are hand-written in migration 0003.
model Unit {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(80)
  cnpj           String?  @db.Char(14)
  timeZone       String   @map("time_zone") @db.VarChar(64)
  phone          String?  @db.VarChar(11)
  email          String?  @db.VarChar(254)
  cep            String?  @db.Char(8)
  street         String?  @db.VarChar(150)
  number         String?  @db.VarChar(20)
  complement     String?  @db.VarChar(80)
  district       String?  @db.VarChar(80)
  city           String?  @db.VarChar(80)
  state          String?  @db.Char(2)
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdById    String?  @map("created_by_id") @db.Uuid
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization                  @relation(fields: [organizationId], references: [id], map: "fk_unit_org")
  businessHours    UnitBusinessHours[]
  closures         UnitClosure[]
  rooms            Room[]
  selections       UnitSelection[]
  workingIntervals ProfessionalWorkingInterval[]

  @@index([organizationId, active], map: "ix_unit_org_active")
  @@map("unit")
}

model UnitBusinessHours {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  weekday        Int      @db.SmallInt
  startMinute    Int      @map("start_minute") @db.SmallInt
  endMinute      Int      @map("end_minute") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade, map: "fk_ubh_unit")

  @@index([unitId, weekday], map: "ix_ubh_unit_weekday")
  @@map("unit_business_hours")
}

model UnitClosure {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  startsOn       DateTime @map("starts_on") @db.Date
  endsOn         DateTime @map("ends_on") @db.Date
  reason         String   @db.VarChar(120)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  unit Unit @relation(fields: [unitId], references: [id], map: "fk_closure_unit")

  @@index([unitId, endsOn, startsOn], map: "ix_closure_unit_period")
  @@map("unit_closure")
}

model Room {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  name           String   @db.VarChar(50)
  description    String?  @db.VarChar(200)
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  unit            Unit                 @relation(fields: [unitId], references: [id], map: "fk_room_unit")
  allowedServices ServiceAllowedRoom[]

  @@index([unitId, active], map: "ix_room_unit_active")
  @@map("room")
}

// The unit chosen in the header, remembered per user (spec F02 section 3).
model UnitSelection {
  userId         String   @id @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_unit_selection_user")
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade, map: "fk_unit_selection_unit")

  @@map("unit_selection")
}

// F03 Service Catalog -----------------------------------------------------------------------

model ServiceCategory {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(50)
  sortOrder      Int      @map("sort_order") @db.SmallInt
  version        Int      @default(1)
  createdById    String?  @map("created_by_id") @db.Uuid
  updatedById    String?  @map("updated_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], map: "fk_service_category_org")
  services     Service[]

  @@index([organizationId, sortOrder], map: "ix_service_category_org_order")
  @@map("service_category")
}

model Service {
  id              String   @id @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  name            String   @db.VarChar(100)
  description     String?  @db.VarChar(500)
  durationMinutes Int      @map("duration_minutes") @db.SmallInt
  priceCents      Int      @map("price_cents")
  color           String   @db.VarChar(16)
  requiresRoom    Boolean  @default(false) @map("requires_room")
  active          Boolean  @default(true)
  version         Int      @default(1)
  createdById     String?  @map("created_by_id") @db.Uuid
  updatedById     String?  @map("updated_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization          @relation(fields: [organizationId], references: [id], map: "fk_service_org")
  category      ServiceCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "fk_service_category")
  allowedRooms  ServiceAllowedRoom[]
  priceChanges  ServicePriceChange[]
  professionals ProfessionalService[]

  @@index([organizationId, active], map: "ix_service_org_active")
  @@index([categoryId], map: "ix_service_category")
  @@map("service")
}

model ServiceAllowedRoom {
  serviceId      String @map("service_id") @db.Uuid
  roomId         String @map("room_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade, map: "fk_service_allowed_room_service")
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Restrict, map: "fk_service_allowed_room_room")

  @@id([serviceId, roomId], map: "pk_service_allowed_room")
  @@index([roomId], map: "ix_service_allowed_room_room")
  @@map("service_allowed_room")
}

// Append-only: the runtime role may only insert and read (migration 0004).
model ServicePriceChange {
  id                 String   @id @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  serviceId          String   @map("service_id") @db.Uuid
  previousPriceCents Int?     @map("previous_price_cents")
  priceCents         Int      @map("price_cents")
  changedAt          DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedById        String?  @map("changed_by_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict, map: "fk_price_change_service")

  @@index([serviceId, changedAt(sort: Desc)], map: "ix_price_change_service_time")
  @@map("service_price_change")
}

// F04 Professionals and Working Hours (spec docs/F04-professionals-and-working-hours/spec.md, section 6).
// Partial unique indexes, CHECK constraints and the validity exclusion constraint are hand-written
// in migration 0005.

model Professional {
  id               String    @id @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  fullName         String    @map("full_name") @db.VarChar(150)
  displayName      String?   @map("display_name") @db.VarChar(60)
  specialty        String?   @db.VarChar(100)
  councilType      String    @default("NONE") @map("council_type") @db.VarChar(10)
  councilOtherName String?   @map("council_other_name") @db.VarChar(20)
  councilNumber    String?   @map("council_number") @db.VarChar(15)
  councilState     String?   @map("council_state") @db.Char(2)
  cpf              String?   @db.Char(11)
  phone            String?   @db.VarChar(11)
  email            String?   @db.VarChar(254)
  color            String    @db.VarChar(16)
  linkedUserId     String?   @unique(map: "uq_professional_linked_user") @map("linked_user_id") @db.Uuid
  active           Boolean   @default(true)
  deactivatedAt    DateTime? @map("deactivated_at") @db.Timestamptz(6)
  version          Int       @default(1)
  createdById      String?   @map("created_by_id") @db.Uuid
  updatedById      String?   @map("updated_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization           @relation(fields: [organizationId], references: [id], map: "fk_professional_org")
  linkedUser   User?                  @relation(fields: [linkedUserId], references: [id], onDelete: Restrict, map: "fk_professional_linked_user")
  services     ProfessionalService[]
  schedules    ProfessionalSchedule[]
  timeOffs     ProfessionalTimeOff[]

  @@index([organizationId, active], map: "ix_professional_org_active")
  @@map("professional")
}

model ProfessionalService {
  professionalId String   @map("professional_id") @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict, map: "fk_professional_service_professional")
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict, map: "fk_professional_service_service")

  @@id([professionalId, serviceId], map: "pk_professional_service")
  @@index([serviceId], map: "ix_professional_service_service")
  @@map("professional_service")
}

// Weekly working hours valid in a date range. A professional's schedules never overlap
// (exclusion constraint ex_schedule_no_overlap in migration 0005).
model ProfessionalSchedule {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  professionalId String    @map("professional_id") @db.Uuid
  validFrom      DateTime  @map("valid_from") @db.Date
  validUntil     DateTime? @map("valid_until") @db.Date
  version        Int       @default(1)
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  professional Professional                  @relation(fields: [professionalId], references: [id], onDelete: Restrict, map: "fk_schedule_professional")
  intervals    ProfessionalWorkingInterval[]

  @@index([professionalId, validFrom], map: "ix_schedule_professional_period")
  @@map("professional_schedule")
}

model ProfessionalWorkingInterval {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scheduleId     String   @map("schedule_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  weekday        Int      @db.SmallInt
  startMinute    Int      @map("start_minute") @db.SmallInt
  endMinute      Int      @map("end_minute") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedule ProfessionalSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade, map: "fk_pwi_schedule")
  unit     Unit                 @relation(fields: [unitId], references: [id], onDelete: Restrict, map: "fk_pwi_unit")

  @@index([scheduleId, weekday], map: "ix_pwi_schedule_weekday")
  @@index([unitId], map: "ix_pwi_unit")
  @@map("professional_working_interval")
}

model ProfessionalTimeOff {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  professionalId String   @map("professional_id") @db.Uuid
  type           String   @db.VarChar(12)
  startsAt       DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(6)
  allDay         Boolean  @default(false) @map("all_day")
  note           String?  @db.VarChar(200)
  createdById    String?  @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict, map: "fk_time_off_professional")

  @@index([professionalId, endsAt, startsAt], map: "ix_time_off_professional_period")
  @@map("professional_time_off")
}

// F05 Patient Registry (spec docs/F05-patient-registry/spec.md, section 6). Trigram search indexes,
// the partial unique CPF index, CHECK constraints and the append-only grants on consent and terms
// are hand-written in migration 0006.

model Patient {
  id                   String    @id @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  fullName             String    @map("full_name") @db.VarChar(150)
  socialName           String?   @map("social_name") @db.VarChar(150)
  normalizedName       String    @map("normalized_name") @db.VarChar(150)
  birthDate            DateTime  @map("birth_date") @db.Date
  sex                  String    @default("NOT_INFORMED") @db.VarChar(12)
  cpf                  String?   @db.Char(11)
  rg                   String?   @db.VarChar(20)
  mobilePhone          String    @map("mobile_phone") @db.VarChar(11)
  secondaryPhone       String?   @map("secondary_phone") @db.VarChar(11)
  phoneDigits          String    @map("phone_digits") @db.VarChar(23)
  email                String?   @db.VarChar(254)
  cep                  String?   @db.Char(8)
  street               String?   @db.VarChar(150)
  number               String?   @db.VarChar(20)
  complement           String?   @db.VarChar(80)
  district             String?   @db.VarChar(80)
  city                 String?   @db.VarChar(80)
  state                String?   @db.Char(2)
  occupation           String?   @db.VarChar(80)
  referralSourceId     String?   @map("referral_source_id") @db.Uuid
  observations         String?   @db.VarChar(2000)
  guardianName         String?   @map("guardian_name") @db.VarChar(150)
  guardianCpf          String?   @map("guardian_cpf") @db.Char(11)
  guardianRelationship String?   @map("guardian_relationship") @db.VarChar(20)
  guardianPhone        String?   @map("guardian_phone") @db.VarChar(11)
  active               Boolean   @default(true)
  inactiveReason       String?   @map("inactive_reason") @db.VarChar(12)
  inactiveNote         String?   @map("inactive_note") @db.VarChar(200)
  deactivatedAt        DateTime? @map("deactivated_at") @db.Timestamptz(6)
  version              Int       @default(1)
  createdById          String?   @map("created_by_id") @db.Uuid
  updatedById          String?   @map("updated_by_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization   Organization    @relation(fields: [organizationId], references: [id], map: "fk_patient_org")
  referralSource ReferralSource? @relation(fields: [referralSourceId], references: [id], onDelete: Restrict, map: "fk_patient_referral_source")
  tags           PatientTag[]
  consents       ConsentRecord[]

  @@index([organizationId, normalizedName, birthDate], map: "ix_patient_org_identity")
  @@index([organizationId, active, normalizedName], map: "ix_patient_org_active_name")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_patient_name_trgm")
  @@index([phoneDigits(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_patient_phone_trgm")
  @@map("patient")
}

model ReferralSource {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(40)
  active         Boolean  @default(true)
  sortOrder      Int      @map("sort_order") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  patients Patient[]

  @@index([organizationId, sortOrder], map: "ix_referral_source_org_order")
  @@map("referral_source")
}

model Tag {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(40)
  active         Boolean  @default(true)
  sortOrder      Int      @map("sort_order") @db.SmallInt
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  patients PatientTag[]

  @@index([organizationId, sortOrder], map: "ix_tag_org_order")
  @@map("tag")
}

model PatientTag {
  patientId      String @map("patient_id") @db.Uuid
  tagId          String @map("tag_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict, map: "fk_patient_tag_patient")
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict, map: "fk_patient_tag_tag")

  @@id([patientId, tagId], map: "pk_patient_tag")
  @@index([tagId], map: "ix_patient_tag_tag")
  @@map("patient_tag")
}

// Append-only: the runtime role may only insert and read (migration 0006).
model PrivacyTermsVersion {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  version        Int
  text           String
  publishedAt    DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedById  String?  @map("published_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  consents ConsentRecord[]

  @@unique([organizationId, version], map: "uq_terms_org_version")
  @@map("privacy_terms_version")
}

// Append-only: legal evidence of LGPD consent (migration 0006).
model ConsentRecord {
  id             String   @id @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  patientId      String   @map("patient_id") @db.Uuid
  termsVersionId String   @map("terms_version_id") @db.Uuid
  consentedAt    DateTime @default(now()) @map("consented_at") @db.Timestamptz(6)
  method         String   @db.VarChar(16)
  recordedById   String   @map("recorded_by_id") @db.Uuid
  fileObjectKey  String?  @map("file_object_key") @db.VarChar(255)
  fileName       String?  @map("file_name") @db.VarChar(150)
  fileSize       Int?     @map("file_size")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict, map: "fk_consent_patient")
  termsVersion PrivacyTermsVersion @relation(fields: [termsVersionId], references: [id], onDelete: Restrict, map: "fk_consent_terms")

  @@index([patientId, consentedAt(sort: Desc)], map: "ix_consent_patient_time")
  @@map("consent_record")
}

// Files uploaded for a consent before the consent consumes them (ADR-023).
model ConsentUpload {
  id             String    @id @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  objectKey      String    @map("object_key") @db.VarChar(255)
  fileName       String    @map("file_name") @db.VarChar(150)
  fileSize       Int       @map("file_size")
  contentType    String    @map("content_type") @db.VarChar(40)
  uploadedById   String    @map("uploaded_by_id") @db.Uuid
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("consent_upload")
}
