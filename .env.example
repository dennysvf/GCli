# Copy to .env for local development. Values match docker-compose.yml.
NODE_ENV=development

# Runtime role (DML only; append-only on audit_event)
DATABASE_URL=postgresql://gcli_app:gcli_app@localhost:5432/gcli
# Owner role (migrations and audit partition maintenance)
DATABASE_MIGRATION_URL=postgresql://gcli_owner:gcli_owner@localhost:5432/gcli

APP_URL=http://localhost:3001
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=change-me-to-a-random-string-with-32-plus-characters
TRUST_PROXY=false

# Mailpit (web UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GCli <no-reply@gcli.local>

# SeaweedFS S3 API (docker-compose.yml); production uses Cloudflare R2
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=gcli-local
S3_ACCESS_KEY_ID=gcli
S3_SECRET_ACCESS_KEY=gcli-local-secret
S3_FORCE_PATH_STYLE=true

# Optional: Sentry is disabled when empty
SENTRY_DSN=
LOG_LEVEL=info
